{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "rateLimit": {
        "maxAttempts": 10
      }
    }
  },
  "browser": {
    "enabled": false
  },
  "agents": {
    "defaults": {
      "memorySearch": {
        "sources": [
          "memory",
          "sessions"
        ],
        "experimental": {
          "sessionMemory": true
        },
        "provider": "openai",
        "remote": {
          "baseUrl": "https://openrouter.ai/api/v1",
          "apiKey": "${OPENROUTER_API_KEY}"
        },
        "model": "text-embedding-3-small"
      }
    }
  },
  "mcp": {
    "servers": {
      "ob1": {
        "url": "${OB1_MCP_URL}",
        "transport": "streamable-http",
        "headers": {
          "x-brain-key": "${OB1_MCP_ACCESS_KEY}"
        },
        "connectionTimeoutMs": 30000
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "streaming": "partial",
      "accounts": {
        "main": {
          "dmPolicy": "pairing",
          "botToken": "${TELEGRAM_BOT_TOKEN}",
          "groupPolicy": "allowlist",
          "streaming": "partial"
        }
      }
    }
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "telegram",
        "accountId": "main"
      }
    }
  ],
  "skills": {
    "entries": {
      "openai-whisper-api": {
        "apiKey": "$OPENAI_API_KEY"
      }
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  }
}