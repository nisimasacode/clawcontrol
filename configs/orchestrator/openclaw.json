{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "trustedProxies": [
      "${OPENCLAW_TRUSTED_PROXIES}"
    ],
    "controlUi": {
      "allowedOrigins": [
        "*"
      ]
    },
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "rateLimit": {
        "maxAttempts": 10
      }
    },
    "remote": {
      "url": "ws://127.0.0.1:${ORCHESTRATOR_GATEWAY_PORT}"
    },
    "port": "${ORCHESTRATOR_GATEWAY_PORT}"
  },
  "browser": {
    "enabled": false
  },
  "models": {
    "providers": {}
  },
  "agents": {
    "defaults": {}
  },
  "mcp": {
    "servers": {
      "ob1": {
        "url": "${OB1_MCP_URL}",
        "transport": "streamable-http",
        "headers": {
          "x-brain-key": "${OB1_MCP_ACCESS_KEY}"
        },
        "connectionTimeoutMs": 30000
      }
    },
    "apps": {
      "sandboxOrigin": "https://sandbox-orchestrator.example.com"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "streaming": {
        "mode": "partial"
      },
      "accounts": {
        "main": {
          "dmPolicy": "pairing",
          "botToken": "${TELEGRAM_BOT_TOKEN}",
          "groupPolicy": "allowlist",
          "streaming": {
            "mode": "partial"
          }
        }
      }
    }
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "telegram",
        "accountId": "main"
      }
    }
  ],
  "skills": {
    "entries": {
      "openai-whisper-api": {
        "apiKey": "${OPENAI_API_KEY}"
      }
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "anthropic": {
        "enabled": true
      },
      "openai": {
        "enabled": true
      },
      "openrouter": {
        "enabled": true
      },
      "codex": {
        "enabled": true,
        "config": {
          "appServer": {
            "clearEnv": [
              "CODEX_API_KEY",
              "OPENAI_API_KEY"
            ]
          }
        }
      },
      "searxng": {
        "config": {
          "webSearch": {
            "baseUrl": "http://searxng:8080"
          }
        }
      }
    }
  },
  "messages": {},
  "commands": {
    "ownerAllowFrom": [
      "telegram:${TELEGRAM_OWNER_ID}"
    ]
  },
  "memory": {
    "search": {
      "sources": [
        "memory",
        "sessions"
      ],
      "experimental": {
        "sessionMemory": true
      },
      "provider": "openai",
      "remote": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}"
      },
      "model": "text-embedding-3-small"
    }
  },
  "tts": {
    "auto": "inbound",
    "provider": "openai",
    "providers": {
      "openai": {
        "apiKey": "${OPENAI_API_KEY}",
        "model": "tts-1",
        "speakerVoice": "onyx"
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "searxng"
      }
    }
  }
}
